# ---------------------------------------------------------------------------
# PodLens environment configuration
# Copy this file to ".env" and fill in real values. Never commit the real .env
# ---------------------------------------------------------------------------

# --- YouTube Data API v3 -----------------------------------------------------
# Required to collect video metadata and comments.
# Create a key in Google Cloud Console with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=

# Maximum number of comments to fetch per video (top-level comments; replies
# fetched per thread are counted too). Keep this reasonable to conserve quota.
MAX_COMMENTS_PER_VIDEO=200

# --- LLM provider (audience summary + future topic suggestions) -----------
# Supported provider: "openai". Leave LLM_API_KEY empty to disable insight
# generation (the app will clearly report that insights are unavailable).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: override the API base URL (e.g. for an OpenAI-compatible proxy).
LLM_API_BASE=

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./podlens.db

# --- ML model artifact locations ---------------------------------------------
# Directories must contain a Hugging Face-format model (config.json,
# tokenizer files, model weights). See model_artifacts/*/README.md.
SENTIMENT_MODEL_DIR=./model_artifacts/sentiment_roberta
SPAM_MODEL_DIR=./model_artifacts/spam_bert_tiny

# Optional explicit label maps, used only if a model's config.json does not
# provide an unambiguous id2label mapping. JSON object mapping string ids to
# label names, e.g. {"0": "not_spam", "1": "spam"}
SPAM_LABEL_MAP=
SENTIMENT_LABEL_MAP=

# Confidence threshold used only for display/flagging purposes, not to
# override the model's own argmax decision.
SPAM_CONFIDENCE_THRESHOLD=0.5

# Batch size used for model inference
MODEL_INFERENCE_BATCH_SIZE=16

# Force CPU even if a GPU is available ("true"/"false")
FORCE_CPU=false

# --- App ---------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
